# Optional: where the frontend's REST + SSE calls go. Defaults to "/api"
# (same-origin), which means the dev server's Vite proxy or the Cloudflare
# Worker server-routes proxy must forward /api/* to the FastAPI backend.
# Set this only if you want the browser to hit the backend directly across
# origins (in which case set WEBAPP_CORS_ORIGINS in webapp1).
# VITE_API_BASE=http://127.0.0.1:8080/api

# Optional legacy: bearer token used only when the API is in
# WEBAPP_AUTH_TOKEN mode (no Clerk). Leave commented when using Clerk.
# VITE_API_TOKEN=

# Dev proxy target (used by vite.config.ts's server.proxy and the Cloudflare
# Worker proxy in apps/web/src/routes/api.$.tsx)
WEBAPP1_API_BASE=http://127.0.0.1:8080

# Clerk publishable key. The VITE_ prefix is REQUIRED — Vite only exposes
# variables with that prefix to the browser bundle. @clerk/tanstack-react-start
# also reads this same var server-side (checks VITE_CLERK_PUBLISHABLE_KEY
# before a plain CLERK_PUBLISHABLE_KEY) — no separate non-VITE var needed.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server-side Clerk secret for the Start server: clerkMiddleware()
# (src/start.ts) and the /api/$ proxy's auth()/getToken() call
# (src/routes/api.$.tsx) both need this. Get it from the Clerk dashboard
# (API Keys) for the same instance as VITE_CLERK_PUBLISHABLE_KEY above.
# CLERK_SECRET_KEY=sk_test_...
